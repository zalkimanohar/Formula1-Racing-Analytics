    }
  ],
  "measurementTechnique": [
    "Automated data profiling across six quality dimensions",
    "Rule-based, audited data cleaning (Python/pandas)"
  ],
  "variableMeasured": [
    {
      "@type": "PropertyValue",
      "name": "result_id",
      "description": "Deterministic surrogate key: season_round_driverId_carNumber.",
      "unitText": "YYYY_RR_<driver_id>_<car_number|NA>"
    },
    {
      "@type": "PropertyValue",
      "name": "race_id",
      "description": "Identifier of the Grand Prix: season and round.",
      "unitText": "YYYY_RR"
    },
    {
      "@type": "PropertyValue",
      "name": "season",
      "description": "Championship season (year).",
      "unitText": "year"
    },
    {
      "@type": "PropertyValue",
      "name": "round",
      "description": "Round number of the race within the season."
    },
    {
      "@type": "PropertyValue",
      "name": "race_name",
      "description": "Official Grand Prix name in title case."
    },
    {
      "@type": "PropertyValue",
      "name": "race_date",
      "description": "Race day.",
      "unitText": "ISO 8601 (YYYY-MM-DD)"
    },
    {
      "@type": "PropertyValue",
      "name": "circuit_id",
      "description": "Circuit identifier (Ergast convention)."
    },
    {
      "@type": "PropertyValue",
      "name": "circuit_name",
      "description": "Circuit name in title case."
    },
    {
      "@type": "PropertyValue",
      "name": "circuit_locality",
      "description": "City or locality of the circuit."
    },
    {
      "@type": "PropertyValue",
      "name": "circuit_country",
